{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmanatic.example/schemas/review_outcome.schema.json",
  "title": "Atmanatic Protocol 0.1 review outcome",
  "description": "Extends the common envelope. See ATMANATIC_PROTOCOL_0.1_DRAFT.md section 6.3.",
  "allOf": [
    { "$ref": "common_envelope.schema.json" },
    {
      "type": "object",
      "required": ["reviewer", "subject_artifact_hash", "challenge_findings", "outcome"],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "description": "MUST be distinct from the subject artifact's producer."
        },
        "subject_artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "challenge_findings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outcome": {
          "enum": ["challenged_and_resolved", "rejected", "insufficient_evidence"]
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "description": "Required when outcome is challenged_and_resolved."
        }
      },
      "if": { "properties": { "outcome": { "const": "challenged_and_resolved" } } },
      "then": { "required": ["resolution"] }
    }
  ]
}
